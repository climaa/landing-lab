{
  "extends": "@lab/tsconfig/base.json",
  // JSDoc-typed `.mjs`, as packages/visual-diff: `checkJs` is what reads the types.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/__tests__"]
}
